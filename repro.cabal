cabal-version: 3.4
name: repro
version: 0
build-type: Simple

flag pkgconfig
  description: The library has pkgconfig-depends on gtk4 and libadwaita-1
  default: False
  manual: True

flag gi
  description: The library depends on gi-glib and gi-gio and registers the bundle
  default: False
  manual: True

common options
  default-language: GHC2024
  ghc-options: -Wall

library
  import: options
  hs-source-dirs: src
  exposed-modules:
    Filler.A
    Filler.B
    Filler.C
    Filler.D
    Filler.E
    Filler.F

  build-depends:
    base,

  if flag(pkgconfig)
    pkgconfig-depends: gtk4, libadwaita-1

  if flag(gi)
    exposed-modules: Resources
    build-depends:
      gi-gio,
      gi-glib,
      haskell-gi-base,
      repro-th,

executable repro
  import: options
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    base,
    bytestring,
    repro,
    repro-th,
