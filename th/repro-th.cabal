cabal-version: 3.4
name: repro-th
version: 0
build-type: Simple
synopsis: The Template Haskell half of the reproducer. No C library dependencies.
extra-source-files:
  data/manifest.txt
  data/gresource/*.svg
  data/gresource/repro.gresource.xml

flag run-io
  description: The splice runs IO through runIO
  default: True
  manual: True

flag spawn
  description: The splice IO spawns processes (needs run-io)
  default: True
  manual: True

flag glib
  description: The splice runs glib-compile-resources, as mediacopy3000 does (overrides run-io and spawn)
  default: False
  manual: True

flag external
  description: Run the splice in the external interpreter
  default: False
  manual: True

library
  default-language: GHC2024
  ghc-options: -Wall
  hs-source-dirs: src
  exposed-modules:
    Embedded
    Splice

  build-depends:
    base,
    bytestring,
    directory,
    filepath,
    process,
    template-haskell,

  if flag(run-io)
    cpp-options: -DRUN_IO

  if flag(spawn)
    cpp-options: -DSPAWN

  if flag(glib)
    cpp-options: -DGLIB

  if flag(external)
    ghc-options: -fexternal-interpreter
